<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel2.Views.NewPage1"
             Title="Contratação de Hospedagem"
             BackgroundColor="#F5F5F5">

    <ContentPage.Resources>
        <Style TargetType="Label">
            <Setter Property="VerticalTextAlignment" Value="Center" />
            <Setter Property="TextColor" Value="#172A46" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="BackgroundColor" Value="#172A46" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="FontAttributes" Value="Bold" />
        </Style>
    </ContentPage.Resources>

    <VerticalStackLayout Padding="15"
                         VerticalOptions="Center"
                         Spacing="15">

        <Label Text="APP HOTEL"
               FontSize="14"
               FontAttributes="Bold"
               TextColor="#B28B45"
               HorizontalTextAlignment="Center" />

        <Label Text="Cálculo da Diária"
               FontFamily="Bungee"
               FontSize="30"
               TextColor="#172A46"
               HorizontalTextAlignment="Center"
               Margin="0,0,0,10" />

        <Border Stroke="#E0E5EC"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                BackgroundColor="White"
                Padding="15">

            <VerticalStackLayout Spacing="15">

                <Label Text="Hóspedes"
                       FontSize="20"
                       FontAttributes="Bold" />

                <Grid ColumnDefinitions="*,*,*"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="15">

                    <Label Grid.Row="0"
                           Grid.Column="0"
                           Text="Adultos:" />

                    <Label Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_adultos}"
                           HorizontalTextAlignment="Center" />

                    <Stepper x:Name="stp_adultos"
                             Grid.Row="0"
                             Grid.Column="2"
                             Minimum="1"
                             Maximum="5"
                             BackgroundColor="#DCE4EF"/>

                    <Label Grid.Row="1"
                           Grid.Column="0"
                           Text="Crianças:" />

                    <Label Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding Value}"
                           BindingContext="{x:Reference stp_criancas}"
                           HorizontalTextAlignment="Center" />

                    <Stepper x:Name="stp_criancas"
                             Grid.Row="1"
                             Grid.Column="2"
                             Minimum="0"
                             Maximum="5"
                             BackgroundColor="#DCE4EF"/>
                </Grid>

                <BoxView HeightRequest="1"
                         Color="#E0E5EC" />

                <Label Text="Selecione sua acomodação:"
                       FontSize="16"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center" />

                <Picker x:Name="pck_quarto" ItemDisplayBinding="{Binding Nome}"
                        Title="Escolha uma acomodação"
                        BackgroundColor="#F5F5F5"
                        TextColor="#172A46" />

                <Border Stroke="#E0E5EC"
                        StrokeShape="RoundRectangle 12"
                        BackgroundColor="#F5F5F5"
                        Padding="12">

                    <Grid RowDefinitions="Auto,Auto"
                          ColumnDefinitions="*,*"
                          RowSpacing="12"
                          ColumnSpacing="5">

                        <Label Grid.Row="0"
                               Grid.Column="0"
                               Text="Data Check-in:"
                               FontAttributes="Bold" />

                        <DatePicker x:Name="dtpck_checkin" DateSelected="dtpck_checkin_DateSelected"
                                    Grid.Row="0"
                                    Grid.Column="1"
                                    TextColor="#172A46" />

                        <Label Grid.Row="1"
                               Grid.Column="0"
                               Text="Data Check-out:"
                               FontAttributes="Bold" />

                        <DatePicker x:Name="dtpck_checkout"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    TextColor="#172A46" />

                    </Grid>
                </Border>

                <Button Text="Calcular!" Clicked="Button_Clicked" />

                <Button Text="Sobre"
                        Clicked="AbrirSobre_Clicked"
                        BackgroundColor="#B28B45"
                        TextColor="White" />

                <Button Text="Cadastro de Evento"
        Clicked="AbrirCadastroEvento_Clicked"
        BackgroundColor="#315B83"
        TextColor="White" />


            </VerticalStackLayout>
        </Border>

        <Label Text="Conforto e praticidade para sua estadia."
               FontSize="12"
               TextColor="#68758A"
               HorizontalTextAlignment="Center" />

    </VerticalStackLayout>
</ContentPage>
