<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel2.Views.CadastroEvento"
             Title="Cadastro de Evento"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="13">

            <Label Text="APP HOTEL" FontSize="14" FontAttributes="Bold" TextColor="#B28B45" HorizontalTextAlignment="Center" />
            <Label Text="Cadastro de Evento" FontSize="28" FontAttributes="Bold" TextColor="#172A46" HorizontalTextAlignment="Center" />

            <Border Stroke="#DEDEDE" StrokeShape="RoundRectangle 16" BackgroundColor="White" Padding="16">
                <VerticalStackLayout Spacing="11">

                    <Label Text="Nome do evento" TextColor="#172A46" FontAttributes="Bold" />
                    <Entry Text="{Binding Nome, Mode=TwoWay}" Placeholder="Ex.: Feira de Tecnologia" TextColor="#172A46" />

                    <Label Text="Data de início" TextColor="#172A46" FontAttributes="Bold" />
                    <!-- Adicionado BackgroundColor para forçar aparecer no Windows -->
                    <DatePicker Date="{Binding DataInicio, Mode=TwoWay}" Format="dd/MM/yyyy" BackgroundColor="White" HeightRequest="45" TextColor="#172A46" />

                    <Label Text="Data de término" TextColor="#172A46" FontAttributes="Bold" />
                    <DatePicker Date="{Binding DataTermino, Mode=TwoWay}" Format="dd/MM/yyyy" BackgroundColor="White" HeightRequest="45" TextColor="#172A46" />

                    <Label Text="Número de participantes" TextColor="#172A46" FontAttributes="Bold" />
                    <Entry Text="{Binding NumeroParticipantes, Mode=TwoWay}" Placeholder="Ex.: 100" Keyboard="Numeric" TextColor="#172A46" />

                    <Label Text="Local do evento" TextColor="#172A46" FontAttributes="Bold" />
                    <Entry Text="{Binding Local, Mode=TwoWay}" Placeholder="Ex.: São Paulo - SP" TextColor="#172A46" />

                    <Label Text="Custo por participante (R$)" TextColor="#172A46" FontAttributes="Bold" />
                    <Entry Text="{Binding CustoPorParticipante, Mode=TwoWay}" Placeholder="Ex.: 50,00" Keyboard="Numeric" TextColor="#172A46" />

                    <Button Text="Cadastrar evento" Clicked="Cadastrar_Clicked" BackgroundColor="#172A46" TextColor="White" CornerRadius="12" HeightRequest="48" FontAttributes="Bold" Margin="0,10,0,0" />
                    <Button Text="Voltar" Clicked="Voltar_Clicked" BackgroundColor="#B28B45" TextColor="White" CornerRadius="12" HeightRequest="45" />

                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>