<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppHotel2.Views.Sobre"
    Title="Sobre"
    BackgroundColor="#F5F5F5">

    <VerticalStackLayout
        Padding="25"
        Spacing="20"
        VerticalOptions="Center">

        <Label
            Text="APP HOTEL"
            FontSize="30"
            FontAttributes="Bold"
            TextColor="#172A46"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Sobre o aplicativo"
            FontSize="22"
            FontAttributes="Bold"
            TextColor="#B28B45"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Este aplicativo foi desenvolvido para facilitar a contratação de hospedagens, permitindo selecionar a acomodação, os hóspedes e o período da estadia."
            FontSize="16"
            TextColor="#333333"
            HorizontalTextAlignment="Center" />

        <BoxView
            HeightRequest="2"
            WidthRequest="120"
            Color="#B28B45"
            HorizontalOptions="Center" />

        <Label
            Text="Desenvolvedor: Guilherme Silva de Souza"
            FontSize="16"
            TextColor="#172A46"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Ano de desenvolvimento: 2026"
            FontSize="16"
            TextColor="#172A46"
            HorizontalTextAlignment="Center" />

        <Button
            Text="Voltar"
            BackgroundColor="#172A46"
            TextColor="White"
            Clicked="Voltar_Clicked" />

    </VerticalStackLayout>
</ContentPage>
